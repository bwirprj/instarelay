[Unit]
Description=InstaRelay FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/instarelay
EnvironmentFile=/home/ubuntu/instarelay/.env
ExecStart=/home/ubuntu/instarelay/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8008 --proxy-headers --root-path ${ROOT_PATH}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
